# LibertyAI — modelo seguro de variáveis de ambiente
#
# Para desenvolvimento local, copie este arquivo como .env na raiz do projeto.
# Para produção, cadastre cada variável no painel Environment Variables do Coolify.
# Nunca faça commit de um arquivo .env com senhas ou chaves reais.
#
# O branch público usa APP_PORT para o mapeamento da porta no Docker Compose.
# A aplicação Node lê PORT; mantenha ambos em 3000 para evitar divergência.

# -----------------------------------------------------------------------------
# Porta e modo de execução
# -----------------------------------------------------------------------------
APP_PORT=3000
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Banco MariaDB
# -----------------------------------------------------------------------------
MYSQL_DATABASE=libertyai
MYSQL_USER=libertyai
MYSQL_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
MYSQL_ROOT_PASSWORD=TROQUE_POR_OUTRA_SENHA_FORTE
DATABASE_URL=mysql://libertyai:TROQUE_POR_UMA_SENHA_FORTE@database:3306/libertyai

# -----------------------------------------------------------------------------
# Painel administrativo
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# Gere com: openssl rand -base64 48
LOCAL_AUTH_SECRET=GERE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# -----------------------------------------------------------------------------
# Armazenamento de documentos — MinIO/S3 interno
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=libertyai-documents
S3_ACCESS_KEY_ID=libertyai-minio
S3_SECRET_ACCESS_KEY=TROQUE_POR_UMA_CHAVE_COM_PELO_MENOS_8_CARACTERES

# -----------------------------------------------------------------------------
# Provedor de IA compatível com Chat Completions
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=COLE_A_CHAVE_PRIVADA_DO_SEU_PROVEDOR
LLM_MODEL=DEFINA_O_IDENTIFICADOR_DO_MODELO

# -----------------------------------------------------------------------------
# Pesquisa web complementar — opcional
# Deixe em branco para desativar o Tavily.
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Operação
# Este limite é aplicado ao processo do chat depois de publicado. O Dockerfile
# define separadamente o heap de build; não substitua isso por NODE_OPTIONS.
# -----------------------------------------------------------------------------
NODE_OPTIONS=--max-old-space-size=512

# -----------------------------------------------------------------------------
# Pasta monitorada
# Em produção, o Compose já usa /app/knowledge e monta a pasta física
# /data/liberty-ai/knowledge da VPS. Para o Windows local, substitua pelo
# caminho real da pasta de conhecimento no seu computador.
# -----------------------------------------------------------------------------
KNOWLEDGE_DIR=/app/knowledge

# -----------------------------------------------------------------------------
# O painel administrativo local funciona com ADMIN_EMAIL, ADMIN_PASSWORD e
# LOCAL_AUTH_SECRET. Não cadastre estas variáveis com valores fictícios.
# -----------------------------------------------------------------------------
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

