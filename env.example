# LibertyAI — referência de configuração, sem valores e sem segredos.
# Preencha as variáveis no .env local ou no ambiente da aplicação no Coolify.
# Não use este modelo vazio para substituir um .env já configurado.
# Ao adicionar ou alterar variáveis no código, atualize este modelo também.

# Execução
# Porta HTTP interna da aplicação; opcional, o código usa 3000 por padrão.
PORT=
# Modo de execução: development no desenvolvimento ou production no servidor.
# O contêiner já define production; o comando de desenvolvimento define development.
NODE_ENV=
# Opções do Node, como o limite de memória do processo; não controla o heap de build.
NODE_OPTIONS=

# Banco MariaDB
# Nome do banco criado pelo Docker Compose.
MYSQL_DATABASE=
# Usuário da aplicação no MariaDB.
MYSQL_USER=
# Senha forte desse usuário, correspondente à utilizada em DATABASE_URL.
MYSQL_PASSWORD=
# Senha forte e distinta para o administrador root do MariaDB.
MYSQL_ROOT_PASSWORD=
# URL de conexão MySQL: protocolo, usuário, senha, servidor, porta e nome do banco.
# Caracteres especiais das credenciais precisam de codificação própria para URL.
DATABASE_URL=

# Autenticação administrativa
# E-mail da conta administrativa inicial.
ADMIN_EMAIL=
# Senha forte para a conta administrativa inicial.
ADMIN_PASSWORD=
# Segredo aleatório de pelo menos 32 caracteres para autenticação local.
LOCAL_AUTH_SECRET=
# Alternativa legada ao segredo local; prefira configurar LOCAL_AUTH_SECRET.
JWT_SECRET=

# Armazenamento S3 ou MinIO
# Endereço do serviço S3 acessível pela aplicação, incluindo protocolo e porta.
S3_ENDPOINT=
# Região utilizada pelo serviço de armazenamento.
S3_REGION=
# Nome do bucket em que os documentos serão guardados.
S3_BUCKET=
# Identificador de acesso S3; o Compose também o usa como usuário do MinIO.
S3_ACCESS_KEY_ID=
# Segredo de acesso S3; o Compose também o usa como senha do MinIO.
S3_SECRET_ACCESS_KEY=

# Provedor de IA do chat
# URL base do provedor compatível com Chat Completions, incluindo a versão da API.
LLM_BASE_URL=
# Chave privada da API do provedor de IA.
LLM_API_KEY=
# Identificador do modelo habilitado na conta do provedor.
LLM_MODEL=
# Tempo máximo de espera pelo provedor, em milissegundos; opcional.
LLM_TIMEOUT_MS=
# Limite base de tokens de saída por resposta; algumas respostas exigem um mínimo maior.
LLM_MAX_COMPLETION_TOKENS=
# Esforço de raciocínio aceito pelo modelo; usado somente pela família GPT-5.
LLM_REASONING_EFFORT=

# Pesquisa externa para responder no chat
# Preencha com true para habilitar ou false para desabilitar a busca externa.
LLM_WEB_SEARCH_ENABLED=
# Modelo compatível com Responses API e a ferramenta de pesquisa web.
LLM_WEB_SEARCH_MODEL=
# URL alternativa para pesquisa; se vazia, reutiliza LLM_BASE_URL.
LLM_WEB_SEARCH_BASE_URL=
# Chave alternativa para pesquisa; se vazia, reutiliza LLM_API_KEY.
LLM_WEB_SEARCH_API_KEY=

# Leitura visual de PDFs
# Preencha com false para desabilitar; habilitada por padrão quando não configurada.
PDF_VISION_ENABLED=
# Modelo com suporte a imagens usado na extração visual de páginas.
PDF_VISION_MODEL=
# Maior número de página elegível para extração visual seletiva; inteiro positivo.
PDF_VISION_MAX_PAGES=

# Pasta de conhecimento
# Caminho da pasta monitorada visto de dentro da aplicação, não o caminho externo da VPS.
# O Compose configura o volume e o caminho interno; localmente use um caminho do computador.
KNOWLEDGE_DIR=
# true para verificar alterações por polling ou false para desativá-lo.
# Se não configurado, o polling é habilitado automaticamente em produção.
KNOWLEDGE_WATCH_POLLING=

# Testes do chat pela API, sem login no navegador
# Chave aleatória exclusiva com pelo menos 32 caracteres; nunca use a chave da IA.
# Deixe vazia para manter a API de testes desativada.
CHAT_TEST_API_KEY=
# URL HTTPS da aplicação; usada somente pelo script local ask-test-api.mjs.
# Não é necessária no servidor. O script lê as variáveis do ambiente do terminal.
LIBERTY_API_URL=
