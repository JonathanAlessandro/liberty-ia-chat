# LibertyAI — modelo seguro de variáveis de ambiente
#
# Para desenvolvimento local, copie este arquivo como .env na raiz do projeto.
# Para produção, cadastre cada variável no painel Environment Variables do Coolify.
# Nunca faça commit de um arquivo .env com senhas ou chaves reais.
#
# O branch público usa APP_PORT para o mapeamento da porta no Docker Compose.
# A aplicação Node lê PORT; mantenha ambos em 3000 para evitar divergência.
#
# MATRIZ DE REFERÊNCIA — obrigatoriedade e origem no código publicado
# APP_PORT                 | Obrigatória no Compose público | docker-compose.yml
# PORT                     | Opcional (padrão 3000)         | server/_core/index.ts
# NODE_ENV                 | Opcional (Docker define)       | Dockerfile, server/_core/index.ts
# MYSQL_DATABASE           | Obrigatória                     | docker-compose.yml
# MYSQL_USER               | Obrigatória                     | docker-compose.yml
# MYSQL_PASSWORD           | Obrigatória                     | docker-compose.yml
# MYSQL_ROOT_PASSWORD      | Obrigatória                     | docker-compose.yml
# DATABASE_URL             | Obrigatória                     | drizzle.config.ts, server/_core/env.ts
# ADMIN_EMAIL              | Obrigatória                     | middlewares/local-admin-auth.middleware.ts
# ADMIN_PASSWORD           | Obrigatória                     | middlewares/local-admin-auth.middleware.ts
# LOCAL_AUTH_SECRET        | Obrigatória na VPS              | middlewares/local-admin-auth.middleware.ts
# JWT_SECRET               | Opcional (fallback local/Manus) | _core/env.ts, local-admin-auth.middleware.ts
# S3_ENDPOINT              | Obrigatória                     | services/document-storage.service.ts
# S3_REGION                | Opcional (padrão us-east-1)    | services/document-storage.service.ts
# S3_BUCKET                | Obrigatória                     | docker-compose.yml, services/document-storage.service.ts
# S3_ACCESS_KEY_ID         | Obrigatória                     | docker-compose.yml, services/document-storage.service.ts
# S3_SECRET_ACCESS_KEY     | Obrigatória                     | docker-compose.yml, services/document-storage.service.ts
# LLM_BASE_URL             | Obrigatória na VPS              | services/llm.service.ts
# LLM_API_KEY              | Obrigatória na VPS              | services/llm.service.ts
# LLM_MODEL                | Opcional (padrão gpt-5-mini)   | services/llm.service.ts
# TAVILY_API_KEY           | Opcional                        | services/external-search.service.ts
# KNOWLEDGE_DIR            | Obrigatória para monitoramento  | services/knowledge-watcher.service.ts
# VITE_APP_ID              | Opcional, apenas OAuth Manus    | server/_core/env.ts
# OAUTH_SERVER_URL          | Opcional, apenas OAuth Manus    | server/_core/env.ts, server/_core/sdk.ts
# OWNER_OPEN_ID            | Opcional, apenas Manus          | server/_core/env.ts
# BUILT_IN_FORGE_API_URL   | Opcional, fallback Manus        | server/_core/env.ts, server/storage.ts
# BUILT_IN_FORGE_API_KEY   | Opcional, fallback Manus        | server/_core/env.ts, server/storage.ts

# -----------------------------------------------------------------------------
# Porta e modo de execução
# -----------------------------------------------------------------------------
APP_PORT=3000
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------------------
# Banco MariaDB
# -----------------------------------------------------------------------------
MYSQL_DATABASE=libertyai
MYSQL_USER=libertyai
MYSQL_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
MYSQL_ROOT_PASSWORD=TROQUE_POR_OUTRA_SENHA_FORTE
DATABASE_URL=mysql://libertyai:TROQUE_POR_UMA_SENHA_FORTE@database:3306/libertyai

# -----------------------------------------------------------------------------
# Painel administrativo
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# Gere com: openssl rand -base64 48
LOCAL_AUTH_SECRET=GERE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES

# -----------------------------------------------------------------------------
# Armazenamento de documentos — MinIO/S3 interno
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=libertyai-documents
S3_ACCESS_KEY_ID=libertyai-minio
S3_SECRET_ACCESS_KEY=TROQUE_POR_UMA_CHAVE_COM_PELO_MENOS_8_CARACTERES

# -----------------------------------------------------------------------------
# Provedor de IA compatível com Chat Completions
# -----------------------------------------------------------------------------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=COLE_A_CHAVE_PRIVADA_DO_SEU_PROVEDOR
LLM_MODEL=DEFINA_O_IDENTIFICADOR_DO_MODELO

# -----------------------------------------------------------------------------
# Pesquisa web complementar — opcional
# Deixe em branco para desativar o Tavily.
# -----------------------------------------------------------------------------
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Operação
# Este limite é aplicado ao processo do chat depois de publicado. O Dockerfile
# define separadamente o heap de build; não substitua isso por NODE_OPTIONS.
# -----------------------------------------------------------------------------
NODE_OPTIONS=--max-old-space-size=512

# -----------------------------------------------------------------------------
# Pasta monitorada
# Em produção, o Compose já usa /app/knowledge e monta a pasta física
# /data/liberty-ai/knowledge da VPS. Para o Windows local, substitua pelo
# caminho real da pasta de conhecimento no seu computador.
# -----------------------------------------------------------------------------
KNOWLEDGE_DIR=/app/knowledge

# -----------------------------------------------------------------------------
# Integrações Manus — não necessárias na VPS autônoma
#
# O painel administrativo local funciona com ADMIN_EMAIL, ADMIN_PASSWORD e
# LOCAL_AUTH_SECRET. Não cadastre estas variáveis com valores fictícios no
# Coolify. Use-as somente se você for operar a autenticação OAuth do Manus.
# -----------------------------------------------------------------------------
# VITE_APP_ID=
# JWT_SECRET=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# -----------------------------------------------------------------------------
# Variáveis que NÃO existem no código e não precisam ser cadastradas:
# MINIO_ROOT_USER, MINIO_ROOT_PASSWORD (o Compose deriva ambas de S3_*).
# VITE_ANALYTICS_ENDPOINT e VITE_ANALYTICS_WEBSITE_ID (não use fora do Manus).
# -----------------------------------------------------------------------------
